# wger Environment Variables
# Copy to .env and fill in values

# Security (generate with: openssl rand -base64 32)
SECRET_KEY=

# JWT Keys (generate with: wger manage.py generate-jwt-keys)
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Database
POSTGRES_PASSWORD=

# Site URL
SITE_URL=https://Fitness.hftv.qzz.io