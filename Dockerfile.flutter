# ==========================================
# Stage 1: Flutter Build (Web + APK)
# ==========================================
FROM ghcr.io/cirruslabs/flutter:3.47.0 AS builder

WORKDIR /app

# Copy pubspec files first for better caching
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# Copy source code
COPY . .

# Build web
RUN flutter build web --release --no-tree-shake-icons

# Build APK
RUN flutter build apk --release

# ==========================================
# Stage 2: Web Runtime (Nginx + Flutter)
# ==========================================
FROM nginx:alpine AS web

# Copy Flutter web build
COPY --from=builder /app/build/web /usr/share/nginx/html

# Copy nginx config
COPY nginx.flutter.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# ==========================================
# Stage 3: APK Artifact (for download)
# ==========================================
FROM scratch AS apk
COPY --from=builder /app/build/app/outputs/flutter-apk/app-release.apk /app-release.apk